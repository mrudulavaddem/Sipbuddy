{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sip Buddy",
  "version": "1.8.0",
  "identifier": "org.blazeyourtrail.sipbuddy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Sip Buddy",
        "width": 280,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Sip Buddy",
        "width": 400,
        "height": 700,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A friendly water reminder",
    "longDescription": "Sip Buddy is a tiny desktop app: a cheerful character walks across your screen to remind you to drink water on the schedule you set.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
